{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets|.*\\.(js|mjs|css|json|ico|png|jpg|jpeg|svg|woff|woff2|ttf|eot|webp|gif|pdf|txt|xml|webmanifest|sw\\.js|registerSW\\.js|workbox-.*)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}